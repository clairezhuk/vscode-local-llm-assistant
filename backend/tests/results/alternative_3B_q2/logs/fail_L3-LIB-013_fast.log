import numpy as np

def normalize_columns(matrix):
    """
    Normalize each column of a 2D NumPy array.
    
    Parameters:
    matrix (numpy.ndarray): The input 2D array to be normalized.
    
    Returns:
    numpy.ndarray: A new 2D array with normalized columns.
    """
    # Calculate the mean and standard deviation for each column
    means = np.mean(matrix, axis=0)
    stds = np.std(matrix, axis=0, ddof=1)  # ddof=1 for sample standard deviation
    
    # Create a mask to identify constant columns (std is zero)
    mask = (stds == 0)
    
    # Normalize each column
    normalized_matrix = matrix.copy()
    for i in range(matrix.shape[1]):
        if not mask[i]:
            normalized_matrix[:, i] = (matrix[:, i] - means[i]) / stds[i]
    
    return normalized_matrix

