import numpy as np

def normalize_columns(matrix):
    """
    Normalize each column of a 2D NumPy array.
    
    Parameters:
    matrix (numpy.ndarray): The input 2D array to be normalized.
    
    Returns:
    numpy.ndarray: A new 2D array with normalized columns.
    """
    # Calculate the mean and standard deviation for each column
    means = np.mean(matrix, axis=0)
    stds = np.std(matrix, axis=0, ddof=1)  # Use ddof=1 for sample standard deviation
    
    # Create a mask to identify constant columns (std is zero)
    constant_columns_mask = (stds == 0)
    
    # Normalize each column, handling constant columns by returning zeros
    normalized_matrix = np.where(constant_columns_mask, np.zeros_like(matrix), (matrix - means) / stds)
    
    return normalized_matrix

# Example usage:
data = np.array([[1, 2], [3, 4], [5, 6]])
normalized_data = normalize_columns(data)
print(normalized_data)
```

This function normalizes each column of a given 2D NumPy array. It calculates the mean and standard deviation for each column, then normalizes the columns by subtracting the mean and dividing by the standard deviation. If any column has a standard deviation of zero (indicating constant values), it returns zeros for that column to avoid division by zero errors.
