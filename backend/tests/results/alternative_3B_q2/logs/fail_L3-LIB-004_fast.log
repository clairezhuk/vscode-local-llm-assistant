import pandas as pd

def get_category_prices(df):
    """
    Group the DataFrame by 'Category' and calculate the average of 'Price'.
    
    Parameters:
    df (DataFrame): The input DataFrame with columns 'Category' and 'Price'.
    
    Returns:
    DataFrame: A DataFrame with two columns: 'Category' and 'Average_Price'.
    """
    # Group by 'Category' and calculate the mean of 'Price'
    category_prices = df.groupby('Category')['Price'].mean().reset_index()
    category_prices.columns = ['Category', 'Average_Price']
    
    return category_prices

# Example usage:
# Assuming df is a DataFrame with columns 'Category' and 'Price'
