import re

def parse_log_errors(logs):
    # Regular expression to match the log format
    pattern = r'(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) (\w+) (.+?)'
    
    # Find all matches in the logs string
    matches = re.findall(pattern, logs)
    
    # Convert each match into a dictionary with 'date' and 'message'
    errors = [{'date': match[0], 'message': match[3]} for match in matches if match[2] == 'ERROR']
    
    return errors

# Example usage:
logs = """
2023-10-05 14:30:00 ERROR Something went wrong!
2023-10-05 14:30:01 INFO Everything is okay.
2023-10-05 14:30:02 ERROR Another error occurred.
"""

errors = parse_log_errors(logs)
print(errors)
```

