import re

def parse_log_errors(logs):
    # Regular expression to match the log format
    log_pattern = r'(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) (\w+) (.+?)'
    
    # Initialize a list to store the parsed logs
    parsed_logs = []
    
    # Use re.findall to extract all matches in one go
    for match in re.findall(log_pattern, logs):
        date, level, message = match
        if level == 'ERROR':
            parsed_logs.append({'date': date, 'message': message})
    
    return parsed_logs

# Example usage:
logs = """
2023-10-05 14:30:00 ERROR Something went wrong!
2023-10-05 14:30:01 INFO Everything is okay.
2023-10-05 14:30:02 ERROR Another error occurred.
"""
parsed_logs = parse_log_errors(logs)
print(parsed_logs)
```

This function uses a regular expression to parse the logs and extracts the date, level, and message. It then filters out only the 'ERROR' level entries and returns them as a list of dictionaries.
