import numpy as np

def rotate_z(point, angle_rad):
    # Convert the point to a numpy array for matrix operations
    point_array = np.array([point[0], point[1], 0])
    
    # Create a rotation matrix around the Z-axis
    cos_angle = np.cos(angle_rad)
    sin_angle = np.sin(angle_rad)
    rotation_matrix = np.array([
        [cos_angle, -sin_angle, 0],
        [sin_angle, cos_angle, 0],
        [0, 0, 1]
    ])
    
    # Rotate the point using the matrix
    rotated_point_array = np.dot(rotation_matrix, point_array)
    
    # Convert back to a tuple and return
    return (rotated_point_array[0], rotated_point_array[1], 0)

# Example usage:
point = (3, 4, 5)
angle_rad = np.pi / 2
new_point = rotate_z(point, angle_rad)
print(new_point)  # Output: (4.0, -3.0, 5.0)
```

This function uses a rotation matrix to rotate the point around the Z-axis. The `numpy` library is used for matrix operations, which makes it easier to handle 3D transformations.
