```python
import math

def assign_clusters(points, centroids):
    def euclidean_distance(point1, point2):
        return math.sqrt((point1[0] - point2[0])**2 + (point1[1] - point2[1])**2)

    def find_closest_centroid(point, centroids):
        min_distance = float('inf')
        closest_centroid = None
        for centroid in centroids:
            distance = euclidean_distance(point, centroid)
            if distance < min_distance:
                min_distance = distance
                closest_centroid = centroid
        return closest_centroid

    cluster_indices = []
    for point in points:
        closest_centroid = find_closest_centroid(point, centroids)
        cluster_indices.append(centroids.index(closest_centroid))
    return cluster_indices
```

This function calculates the Euclidean distance between each point and each centroid, determines which centroid is closest to each point, and assigns the index of that centroid as the cluster index for that point.
