def parse_nested_logs(lines):
    result = {}
    for line in lines:
        # Split the line into parts based on ':'
        parts = line.split(':')
        
        # Check if there are at least two parts
        if len(parts) >= 2:
            name, value = parts[0].strip(), parts[1].strip()
            
            # If the Name is already in the result dictionary, append Value to its list
            if name in result:
                result[name].append(value)
            else:
                result[name] = [value]
    
    return result

