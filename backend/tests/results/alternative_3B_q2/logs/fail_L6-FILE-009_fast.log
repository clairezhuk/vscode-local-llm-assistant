import csv

def calculate_avg(file_path):
    total_amount = 0
    count = 0
    
    with open(file_path, mode='r', newline='', encoding='utf-8') as file:
        reader = csv.DictReader(file)
        for row in reader:
            amount = float(row['Amount'])
            total_amount += amount
            count += 1
    
    if count > 0:
        average_amount = total_amount / count
    else:
        average_amount = 0
    
    return average_amount

# Example usage:
file_path = 'sales.csv'
average_amount = calculate_avg(file_path)
print(f"The average value of the 'Amount' column is: {average_amount}")
```

This function reads the CSV file using `csv.DictReader` to handle headers, calculates the total amount and counts the number of rows, then computes the average. It handles cases where there might be no data by returning 0 if the count is zero.
