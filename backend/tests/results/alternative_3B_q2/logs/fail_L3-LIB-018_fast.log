import numpy as np

def subtract_row_vec(matrix, vec):
    """
    Subtract a 1D vector from each row of a 2D matrix using NumPy broadcasting.

    Parameters:
    - matrix: A 2D NumPy array of shape (M, N)
    - vec: A 1D NumPy array of shape (N,) to be subtracted from each row

    Returns:
    - A 2D NumPy array of shape (M, N) with the vector subtracted from each row
    """
    return matrix - vec.reshape(-1, 1)

# Example usage:
matrix = np.array([[1, 2], [3, 4]])
vec = np.array([5, 6])
result = subtract_row_vec(matrix, vec)
print(result)
```

