import os

def merge_txt_files():
    # Define the directory where the .txt files are located
    workspace = "C:\\Users\\user\AppData\\Local\\Temp\\tmpleg2rci8"
    
    # List all .txt files in the directory
    txt_files = [f for f in os.listdir(workspace) if f.endswith('.txt')]
    
    # Create a file to write the combined content
    with open('combined.log', 'w') as combined_file:
        for file in txt_files:
            # Read each file and append its content to the combined file
            with open(os.path.join(workspace, file), 'r') as f:
                combined_file.write(f.read())
                combined_file.write('\n')
    
    return "Merging complete."

# Example usage
print(merge_txt_files())
```

