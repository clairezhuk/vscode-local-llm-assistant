import os

def merge_txt_files():
    # Define the directory where the .txt files are located
    workspace = "C:\\Users\\user\AppData\\Local\\Temp\\tmpg9w9ngmk"
    
    # Initialize an empty list to store file contents
    all_contents = []
    
    # Iterate over each file in the directory
    for filename in os.listdir(workspace):
        if filename.endswith('.txt'):
            # Construct full path to the file
            file_path = os.path.join(workspace, filename)
            
            # Read the content of the file and add it to the list
            with open(file_path, 'r') as file:
                all_contents.append(file.read())
    
    # Join all contents with a newline character
    combined_content = '\n'.join(all_contents)
    
    # Write the combined content to a new file named 'combined.log'
    with open('combined.log', 'w') as log_file:
        log_file.write(combined_content)
    
    return "Merging complete. Check for 'combined.log' in the current workspace."

