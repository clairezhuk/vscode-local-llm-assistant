import os

def get_safe_path(base_dir, user_file):
    # Ensure base_dir ends with a slash for consistent path joining
    if not base_dir.endswith('/'):
        base_dir += '/'
    
    # Construct the full path to the file
    full_path = os.path.join(base_dir, user_file)
    
    # Resolve the absolute path of the file
    abs_path = os.path.abspath(full_path)
    
    # Check if the absolute path is within the base directory
    if abs_path.startswith(base_dir):
        return abs_path
    else:
        raise ValueError("File path is outside the specified base directory.")

