```python
import os

# Function to read data from a file
def read_data(file_path):
    with open(file_path, 'r') as file:
        return file.readlines()

# Function to write data to a file
def write_data(file_path, data):
    with open(file_path, 'w') as file:
        file.writelines(data)

# Function to merge two sorted lists
def merge_sorted_lists(left, right):
    merged = []
    left_index = 0
    right_index = 0

    while left_index < len(left) and right_index < len(right):
        if int(left[left_index].strip()) <= int(right[right_index].strip()):
            merged.append(left[left_index])
            left_index += 1
        else:
            merged.append(right[right_index])
            right_index += 1

    # Append remaining elements from the left list
    while left_index < len(left):
        merged.append(left[left_index])
        left_index += 1

    # Append remaining elements from the right list
    while right_index < len(right):
        merged.append(right[right_index])
        right_index += 1

    return merged

# Function to sort a file using External Sort
def external_sort(file_path, chunk_size=10 * 1024 * 1024):  # 10MB chunks
    # Step 1: Read the data from the file
    data = read_data(file_path)

    # Step 2: Divide the data into smaller chunks
    num_chunks = len(data) // chunk_size + (len(data) % chunk_size != 0)
    chunks = [data[i * chunk_size:(i + 1) * chunk_size] for i in range(num_chunks)]

    # Step 3: Sort each chunk using Timsort
    sorted_chunks = []
    for chunk in chunks:
        sorted_chunk = sorted(chunk, key=lambda x: int(x.strip()))
        sorted_chunks.append(sorted_chunk)

    # Step 4: Merge the sorted chunks back together
    merged_data = []
    while sorted_chunks:
        merged_data.extend(merge_sorted_lists(sorted_chunks.pop(0), sorted_chunks.pop(0)))

    # Write the merged data back to the file
    write_data(file_path, merged_data)

