import numpy as np

def transpose_matrix(file_path):
    # Read the matrix from the file
    with open(file_path, 'r') as file:
        lines = file.readlines()
    
    # Convert each line to a list of integers and then to a numpy array
    matrix = np.array([[int(num) for num in line.strip().split()] for line in lines])
    
    # Transpose the matrix
    transposed_matrix = np.transpose(matrix)
    
    return transposed_matrix

# Example usage
file_path = 'riddle.txt'
result = transpose_matrix(file_path)
print(result)
```
