from sklearn.model_selection import train_test_split

def split_data(X, y):
    """
    Splits the data into a training set and a test set (20% test) while preserving class proportions.
    
    Parameters:
    - X: Feature matrix as a numpy array or pandas DataFrame.
    - y: Target vector as a numpy array or pandas Series.
    
    Returns:
    - X_train, y_train: Training set features and target vectors.
    - X_test, y_test: Test set features and target vectors.
    """
    # Split the data into training and test sets while preserving class proportions
    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, stratify=y)
    
    return X_train, y_train, X_test, y_test

