def parse_log_errors(logs):
    entries = []
    
    # Split the log entries into individual lines
    lines = logs.split('\n')
    
    # Iterate over each line
    for line in lines:
        if 'ERROR' in line:
            # Split the line into date, level, and message
            date, level, message = line.strip().split(' ')
            
            # Append a dictionary to the entries list
            entries.append({'date': date, 'level': level, 'message': message})
    
    return entries
```


