import re

def parse_log_errors(logs):
    entries = []
    
    for line in logs.split('\n'):
        match = re.match(r'\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\] (\w+) (.*)', line)
        if match:
            date, level, message = match.groups()
            entries.append({'date': date, 'message': message})
    
    return entries
```

