```python
import numpy as np

def apply_threshold(arr, threshold):
    result = np.zeros_like(arr)
    
    for i in range(len(arr)):
        for j in range(len(arr[i])):
            if arr[i][j] > threshold:
                result[i][j] = 0
    
    return result
