```python
import math

def euclidean_distance(p1, p2):
    x1, y1 = p1
    x2, y2 = p2
    
    dx = x2 - x1
    dy = y2 - y1
    
    dx_squared = dx * dx
    dy_squared = dy * dy
    
    sum_of_squares = dx_squared + dy_squared
    
    distance = math.sqrt(sum_of_squares)
    return distance
```

