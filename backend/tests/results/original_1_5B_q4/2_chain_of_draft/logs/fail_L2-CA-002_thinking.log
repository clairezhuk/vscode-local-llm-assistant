from collections import deque

def bfs_shortest_path(graph, start, goal):
    # Initialize the queue with the start node and set its distance to 0
    queue = deque([start])
    distances = {start: 0}
    
    while queue:
        current_node = queue.popleft()
        
        for neighbor in graph[current_node]:
            if neighbor not in distances or distances[neighbor] > distances[current_node] + 1:
                distances[neighbor] = distances[current_node] + 1
                queue.append(neighbor)
    
    # Return the shortest path from start to goal, or None if no path exists
    return distances.get(goal, None)
