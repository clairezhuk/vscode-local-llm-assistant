from collections import deque

def bfs_shortest_path(graph, start, goal):
    # Initialize the queue and distance dictionary
    Q = deque([start])
    dist = {node: float('inf') for node in graph}
    dist[start] = 0
    
    # Mark the starting node as visited
    visited = set()
    
    while Q:
        u = Q.popleft()  # Dequeue a node from the front of the queue
        
        if u == goal:
            return [u]  # Return the shortest path
        
        for v in graph[u]:
            if v not in visited:
                dist[v] = dist[u] + 1
                Q.append(v)  # Add the neighbor to the queue
                visited.add(v)  # Mark the neighbor as visited
    
    return None  # Return None if no path is found
