import asyncio

class TaskID:
    def __init__(self, id):
        self.id = id

async def bounded_fetch(sem, task_id):
    # Acquire a permit from the semaphore
    await sem.acquire()
    
    try:
        # Simulate fetching by sleeping for 0.1 seconds
        await asyncio.sleep(0.1)
        
        # Return the task ID
        return task_id
    finally:
        # Release the semaphore to allow other tasks to acquire it
        sem.release()
```

