import json

def read_config_file(file_path, data):
    with open(file_path, 'r') as file:
        data = json.load(file)
    return data

def write_json_to_file(data, output_file):
    with open(output_file, 'w') as file:
        json.dump(data, file, indent=4)

# Example usage
config_data = read_config_file('config.json', {})
config_data['database']['port'] = 5432
write_json_to_file(config_data, 'modified_config.json')
