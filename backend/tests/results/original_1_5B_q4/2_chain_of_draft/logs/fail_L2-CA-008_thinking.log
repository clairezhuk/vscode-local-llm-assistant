import math

def ucb1(node_win_rate, node_visits, total_parent_visits, exploration_weight=1.41):
    # Calculate the average win rate per visit
    avg_win_rate = node_win_rate / node_visits
    
    # Calculate the square root of the logarithm of the total parent visits
    sqrt_log_total_parent_visits = math.sqrt(math.log(total_parent_visits))
    
    # Return the UCB1 value
    return avg_win_rate + exploration_weight * sqrt_log_total_parent_visits
