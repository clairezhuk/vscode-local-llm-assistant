def calculate_tax(country, amount):
    # Define a dictionary with tax rates
    tax_rates = {
        'USA': 0.1,
        'UK': 0.2,
        'PL': 0.23
    }
    
    # Retrieve the tax rate for the given country
    tax_rate = tax_rates.get(country, None)
    
    # Check if the tax rate is found
    if tax_rate is not None:
        # Calculate total tax by multiplying amount with tax rate
        total_tax = amount * tax_rate
        return total_tax
    else:
        # Return an error message if country is not found in tax rates
        return "Country not found"
```

