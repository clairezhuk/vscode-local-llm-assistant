from collections import deque

def grid_shortest_path(grid, start_row, start_col, end_row, end_col):
    n = len(grid)
    m = len(grid[0])
    
    # Initialize the visited matrix with False
    visited = [[False] * m for _ in range(n)]
    
    # Initialize the queue with the starting cell and distance 0
    queue = deque([(start_row, start_col, 0)])
    
    # Mark the starting cell as visited
    visited[start_row][start_col] = True
    
    while queue:
        row, col, dist = queue.popleft()
        
        if (row, col) == (end_row, end_col):
            return dist
        
        # Explore up moves
        for dr, dc in [(0, 1), (0, -1)]:
            new_row, new_col = row + dr, col + dc
            
            if 0 <= new_row < n and 0 <= new_col < m and grid[new_row][new_col] == 0 and not visited[new_row][new_col]:
                queue.append((new_row, new_col, dist + 1))
                visited[new_row][new_col] = True
    
    return -1
