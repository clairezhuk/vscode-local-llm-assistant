import pandas as pd

def merge_data(df1, df2):
    # Read input data from files
    df1 = pd.read_csv('data1.txt', header=None)
    df2 = pd.read_csv('data2.txt', header=None)
    
    # Extract 'id' and 'year' columns
    id_col = df1.iloc[:, 0]
    year_col = df1.iloc[:, 1]
    data1 = list(zip(id_col, year_col))
    
    id_col = df2.iloc[:, 0]
    year_col = df2.iloc[:, 1]
    data2 = list(zip(id_col, year_col))
    
    # Initialize merged data dictionary
    merged_data = {}
    
    # Process each data point from the first DataFrame
    for id, year in data1:
        key = (id, year)
        if key not in merged_data:
            merged_data[key] = [data1[0]]
        else:
            merged_data[key].append(data1[0])
    
    # Process each data point from the second DataFrame
    for id, year in data2:
        key = (id, year)
        if key not in merged_data:
            merged_data[key] = [data2[0]]
        else:
            merged_data[key].append(data2[0])
    
    return merged_data

# Example usage
merged_result = merge_data(df1, df2)
print(merged_result)
