import pandas as pd

def merge_data(df1, df2):
    if not all('id' in df1.columns and 'year' in df1.columns for df1 in [df1, df2]):
        raise ValueError("Both DataFrames must have 'id' and 'year' columns.")
    
    if not all('id' in df2.columns and 'year' in df2.columns for df2 in [df1, df2]):
        raise ValueError("Both DataFrames must have 'id' and 'year' columns.")
    
