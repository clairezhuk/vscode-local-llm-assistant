```python
import math

def get_metrics(y_true, y_pred):
    # Calculate Mean Squared Error (MSE)
    mse = sum((y - y_pred) ** 2 for y in y_true) / len(y_true)
    
    # Calculate R-squared Score
    mean_y = sum(y_true) / len(y_true)
    ssr = sum((y - mean_y) ** 2 for y in y_true)
    sst = sum((y - mean_y) ** 2 for y in y_pred)
    r_squared = 1 - (ssr / sst)
    
    return mse, r_squared
```


