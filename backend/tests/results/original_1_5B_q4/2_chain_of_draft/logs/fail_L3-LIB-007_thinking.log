import matplotlib.pyplot as plt

def create_plot(x, y):
    """
    Generates a line plot with specified x and y data.
    
    Parameters:
    - x: A list of values for the x-axis.
    - y: A list of corresponding y-values.
    """
    # Check if inputs are lists
    if not isinstance(x, list) or not isinstance(y, list):
        raise ValueError("Both x and y must be lists.")
    
    # Create plot
    plt.plot(x, y)
    
    # Display plot
    plt.show()
