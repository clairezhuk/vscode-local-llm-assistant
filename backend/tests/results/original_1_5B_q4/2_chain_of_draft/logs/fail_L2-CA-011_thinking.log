```python
import numpy as np

def rotate_z(point, angle_rad):
    # Extract x and y coordinates of the point
    x, y, z = point
    
    # Calculate cosine and sine of the rotation angle
    cos_theta = np.cos(angle_rad)
    sin_theta = np.sin(angle_rad)
    
    # Compute the new x coordinate
    new_x = x * cos_theta - y * sin_theta
    
    # Compute the new y coordinate
    new_y = x * sin_theta + y * cos_theta
    
    # Return the new coordinates as a tuple
    return (new_x, new_y, z)
