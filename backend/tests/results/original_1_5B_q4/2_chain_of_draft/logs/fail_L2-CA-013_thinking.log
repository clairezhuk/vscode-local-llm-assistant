import re

def parse_nested_logs(lines):
    data = {}
    for line in lines:
        match = re.search(r'Module\[([^\]]+)\]: Status\[(.*?)\]', line)
        if match:
            name, value = match.groups()
            if name not in data:
                data[name] = value
            else:
                data[name] += f", {value}"
    return data
```

