import numpy as np

def get_row_max_indices(matrix):
    """
    Returns the indices of the maximum values in each row of a 2D NumPy array.
    
    Parameters:
    matrix (np.ndarray): A 2. 
    Returns:
    np.ndarray: An array containing the indices of the maximum values in each row.
    """
    # Find the maximum value in each row
    max_values = np.max(matrix, axis=1)
    
    # Get the indices of these maximum values
    max_indices = np.argmax(max_values, axis=0)
    
    return max_indices
```


