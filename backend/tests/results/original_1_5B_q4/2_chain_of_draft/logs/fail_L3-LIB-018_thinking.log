import numpy as np

def subtract_row_vec(matrix, vec):
    """
    Subtract a 1D vector from each row of a 2D NumPy array using broadcasting.
    
    Parameters:
    - matrix: A 2D NumPy array.
    - vec: A 1D NumPy array (length must match the number of rows in matrix).
    
    Returns:
    - A 2D NumPy array with each row subtracted by the vector.
    """
    # Check if the length of the vector matches the number of rows in the matrix
    if len(vec) != matrix.shape[0]:
        raise ValueError("The length of the vector must match the number of rows in the matrix.")
    
    # Perform broadcasting to subtract the vector from each row
    result = matrix - vec[:, np.newaxis]
    
    return result
```

