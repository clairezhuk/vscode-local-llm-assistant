```python
def count_vowels(s):
    # Initialize a counter to zero
    vowel_count = 0
    
    # Iterate through each character in the input string s
    for char in s:
        # Convert it to lowercase using the lower() method
        char_lower = char.lower()
        
        # Check if the lowercase character is one of the vowels ('a', 'e', 'i', 'o', 'u')
        if char_lower in ['a', 'e', 'i', 'o', 'u']:
            # If it is, increment the counter by 1
            vowel_count += 1
    
    # After iterating through all characters, return the value of the counter
    return vowel_count
```

