import csv

def calculate_avg(file_path):
    total_amount = 0
    count = 0
    
    with open(file_path, mode='r') as file:
        reader = csv.reader(file)
        
        next(reader)  # Skip the header row
        
        for row in reader:
            amount = float(row[0])
            
            total_amount += amount
            count += 1

    average = total_amount / count if count > 0 else None
    
    return average
```

