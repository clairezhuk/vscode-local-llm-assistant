```python
import csv

def calculate_avg(file_path):
    total_amount = 0
    count = 0
    
    with open(file_path, 'r') as file:
        reader = csv.DictReader(file)
        
        for row in reader:
            amount = float(row['Amount']) if row['Amount'].isdigit() else 0
            
            total_amount += amount
            count += 1
    
    if count > 0:
        avg = total_amount / count
    else:
        avg = 0
    
    return avg
```

