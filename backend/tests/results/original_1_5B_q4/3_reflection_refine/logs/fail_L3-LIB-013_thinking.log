import numpy as np

def normalize_columns(matrix):
    """
    Normalizes each column of a 2D NumPy array by subtracting the mean and dividing by the standard deviation.
    
    Parameters:
    matrix (np.ndarray):
    Returns:
    np.ndarray: A new 2D NumPy array with normalized columns.
    """
    # Check if the input is a valid 2D numpy array
    if not isinstance(matrix, np.ndarray) or matrix.ndim != 2:
        raise ValueError("Input must be a 2D numpy array.")
    
    # Calculate mean and standard deviation for each column
    means = np.mean(matrix, axis=0)
    stds = np.std(matrix, axis=0)
    
    # Normalize columns
    normalized_matrix = (matrix - means) / stds
    
    return normalized_matrix

# Example usage:
if __name__ == "__main__":
    matrix = np.array([[1, 2, 3], [4, 5, 6]])
    normalized_matrix = normalize_columns(matrix)
    print(normalized_matrix)
