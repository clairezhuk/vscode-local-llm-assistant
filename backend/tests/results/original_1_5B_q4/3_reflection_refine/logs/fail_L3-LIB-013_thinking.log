import numpy as np

def normalize_columns(matrix):
    """
    Normalizes each column of a 2D NumPy array by subtracting the mean and dividing by the standard deviation.
    
    Parameters:
    matrix (np.ndarray):
    Returns:
    np.ndarray: A new 2D NumPy array with normalized columns.
    """
    # Calculate the mean and standard deviation for each column
    means = np.mean(matrix, axis=0)
    stds = np.std(matrix, axis=0)
    
    # Avoid division by zero errors by setting standard deviations to zero where they are zero
    stds[stds == 0] = 1
    
    # Normalize the columns
    normalized_matrix = (matrix - means) / stds
    
    return normalized_matrix
```


