import numpy as np

def subtract_row_vec(matrix, vec):
    """
    Subtract a 1D array from each row of a 2D NumPy array using broadcasting.

    Parameters:
    - matrix (np.ndarray): A 2D NumPy array of shape (M, N)
    - vec (np.ndarray): A 1D NumPy array of shape (N)

    Returns:
    - np.ndarray: The result of subtracting 'vec' from each row of 'matrix'
    """
    return matrix - vec[:, None]
```


