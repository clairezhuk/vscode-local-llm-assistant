class AgeManager:
    def __init__(self):
        self._driver_age = None
        self._voter_age = None

    def _validate_age(self, age):
        if not 0 <= age <= 120:
            raise ValueError("Age must be between 0 and 120.")
        return True

    def set_driver_age(self, age):
        try:
            self._driver_age = self._validate_age(age)
            return "Valid"
        except ValueError as e:
            return str(e)

    def set_voter_age(self, age):
        try:
            self._voter_age = self._validate_age(age)
            return "Valid"
        except ValueError as e:
            return str(e)

# Example usage
age_manager = AgeManager()
print(age_manager.set_driver_age(25))  # Output: Valid
print(age_manager.set_voter_age(18))  # Output: Valid
try:
    print(age_manager.set_driver_age(-1))  # Raises ValueError: Age must be between 0 and 120.
except ValueError as e:
    print(e)  # Output: Age must be between 0 and 120.
