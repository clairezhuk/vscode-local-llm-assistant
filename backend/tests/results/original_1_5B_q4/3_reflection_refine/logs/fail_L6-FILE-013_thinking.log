import os

def merge_txt_files():
    # Get the current working directory
    cwd = os.getcwd()
    
    # List all .txt files in the current directory
    txt_files = [f for f in os.listdir(cwd) if f.endswith('.txt')]
    
    # Open a new file to write the merged content
    with open('combined.log', 'w') as combined_file:
        for txt_file in txt_files:
            # Open each .txt file and read its content
