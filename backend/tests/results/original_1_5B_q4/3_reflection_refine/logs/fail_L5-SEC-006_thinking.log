import os

def get_safe_path(base_dir, user_file):
    # Join base_dir and user_file to form the full path
    full_path = os.path.join(base_dir, user_file)
    
    # Resolve the absolute path
    abs_path = os.path.abspath(full_path)
    
    # Verify if the absolute path is still within base_dir
    return abs_path.startswith(os.path.abspath(base_dir))
