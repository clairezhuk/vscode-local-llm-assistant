from collections import deque

def bfs_shortest_path(graph, start, goal):
    # Initialize the queue with the starting node and set its distance to 0
    queue = deque([(start, 0)])
    
    # Dictionary to keep track of visited nodes and their shortest distances from the start
    visited = {start: 0}
    
    while queue:
        current_node, current_distance = queue.popleft()
        
        if current_node == goal:
            return [current_node]  # Return the path as a list
        
        for neighbor in graph[current_node]:
            if neighbor not in visited or current_distance + 1 < visited[neighbor]:
                visited[neighbor] = current_distance + 1
                queue.append((neighbor, current_distance + 1))
    
    return []  # Return an empty list if no path is found
```

