from datetime import datetime

def parse_log_errors(logs):
    entries = []
    for line in logs.split('\n'):
        if 'ERROR' in line:
            date, level, message = line.strip().split(' ')
            entries.append({'date': datetime.strptime(date, '%Y-%m-%d %H:%M:%S'), 'message': message})
    return entries
