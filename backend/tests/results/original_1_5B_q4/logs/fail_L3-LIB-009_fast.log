import numpy as np

def split_data(X, y):
    """
    Splits the data into a training set and a test set (20% test) while preserving class proportions.
    
    Parameters:
    X (np.ndarray): The feature matrix.
    y (np.ndarray): The target vector.
    
    Returns:
    tuple: A tuple containing the training features and labels, and the test features and labels.
    """
    # Calculate the number of samples in each class
    class_counts = np.bincount(y)
    total_samples = len(y)
    
    # Determine the number of samples for the test set (20%)
    test_set_size = int(total_samples * 0.2)
    
    # Create a list to store indices for each class
    class_indices = [[] for _ in range(len(class_counts))]
    
    # Assign indices to each class
    for i, idx in enumerate(y):
        class_indices[idx].append(i)
    
    # Shuffle the indices for each class
    for class_idx in class_indices:
        np.random.shuffle(class_idx)
    
    # Split the data into training and test sets
    train_indices = []
    test_indices = []
    
    for i, idx_list in enumerate(class_indices):
        if len(idx_list) > test_set_size:
            train_indices.extend(idx_list[:test_set_size])
            test_indices.extend(idx_list[test_set_size:])
        else:
            train_indices.extend(idx_list)
            test_indices.extend(range(len(idx_list)))
    
    # Convert indices back to arrays
    X_train = X[train_indices]
    y_train = y[train_indices]
    X_test = X[test_indices]
    y_test = y[test_indices]
    
    return (X_train, y_train), (X_test, y_test)
