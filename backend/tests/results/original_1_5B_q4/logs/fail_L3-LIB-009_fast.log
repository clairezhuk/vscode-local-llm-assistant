import pandas as pd

def split_data(X, y):
    """
    Splits the data into a training set and a test set (20% test) while preserving class proportions.
    
    Parameters:
    X (pd.DataFrame): Features of the dataset.
    y (pd.Series): Target variable of the dataset.
    
    Returns:
    tuple: A tuple containing the training set features and target, and the test set features and target.
    """
    from sklearn.model_selection import train_test_split
    
    # Splitting the data into training and test sets while preserving class proportions
    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, stratify=y)
    
    return (X_train, y_train), (X_test, y_test)
