import os

def merge_txt_files():
    combined_content = ""
    
    # Get all .txt files in the current workspace
    txt_files = [f for f in os.listdir('.') if f.endswith('.txt')]
    
    for file_name in txt_files:
        with open(file_name, 'r') as file:
            content = file.read()
            combined_content += content + '\n'  # Add a newline after each file's content
    
    # Write the combined content to combined.log
    with open('combined.log', 'w') as file:
        file.write(combined_content)
    
    return "Combined log created successfully."
