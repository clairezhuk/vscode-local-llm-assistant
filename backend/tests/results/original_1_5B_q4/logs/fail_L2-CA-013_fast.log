import re

def parse_nested_logs(lines):
    log_dict = {}
    for line in lines:
        match = re.search(r'Module\[(.*?)\]: Status\[(.*?)\]', line)
        if match:
            module_name = match.group(1)
            status_value = match.group(2)
            log_dict[module_name] = status_value
    return log_dict
