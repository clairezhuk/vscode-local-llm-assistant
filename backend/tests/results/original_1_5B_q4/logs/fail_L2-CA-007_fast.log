import re

def parse_log_errors(logs):
    # Regular expression to match the log entry format
    pattern = r'\[(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2})\] \[ERROR\] (.+)'
    
    # Split the logs into individual entries
    entries = logs.split('\n')
    
    # Initialize an empty list to store dictionaries for each 'ERROR' level entry
    error_entries = []
    
    # Iterate over each log entry
    for entry in entries:
        # Use regular expression to match the pattern and extract date and message
        match = re.match(pattern, entry)
        if match:
            # Extract the date and message from the match object
            date = match.group(1)
            message = match.group(2)
            
            # Create a dictionary for the 'ERROR' level entry
            error_entry = {
                'date': date,
                'message': message
            }
            
            # Append the dictionary to the list of error entries
            error_entries.append(error_entry)
    
    return error_entries
