import numpy as np

def subtract_row_vec(matrix, vec):
    """
    Subtract a 1D vector from each row of a 2D NumPy array using broadcasting.

    Parameters:
    - matrix: A 2D NumPy array of shape (M, N).
    - vec: A 1D NumPy array of shape (N,) representing the vector to subtract.

    Returns:
    - A 2D NumPy array with each row subtracted by the corresponding element in 'vec'.
    """
    return matrix - vec[:, np.newaxis]
