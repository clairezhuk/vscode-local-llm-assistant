import numpy as np

def subtract_row_vec(matrix, vec):
    """
    Subtract a 1D vector from each row of a 2D NumPy array using broadcasting.

    Parameters:
    matrix (np.ndarray): A 2D NumPy array of shape (M, N).
    vec (np.ndarray): A 1D NumPy array of shape (N,) to be subtracted from each row of the matrix.

    Returns:
    np.ndarray: A new 2D NumPy array with the same shape as 'matrix' after subtracting 'vec' from each row.
    """
    return matrix - vec[:, np.newaxis]
