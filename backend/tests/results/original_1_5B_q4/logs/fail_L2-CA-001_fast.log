def dfs_path(graph, start, goal):
    visited = set()
    path = []

    def dfs(node):
        if node == goal:
            return True
        if node in visited:
            return False
        visited.add(node)
        for neighbor in graph[node]:
            if dfs(neighbor):
                path.append(node)
                return True
        path.pop()
        return False

    dfs(start)
    return path[::-1]  # Reverse the path to get the correct order
