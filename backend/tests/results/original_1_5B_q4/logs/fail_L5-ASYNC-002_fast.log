async def main():
    semaphore = asyncio.Semaphore(2)  # Limit to 2 concurrent fetches
    tasks = [bounded_fetch(semaphore, i) for i in range(5)]
    
    await asyncio.gather(*tasks)

# Run the event loop
asyncio.run(main())
