from collections import deque

def grid_shortest_path(grid, start, end):
    rows, cols = len(grid), len(grid[0])
    directions = [(1, 0), (-1, 0), (0, 1), (0, -1)]
    
    queue = deque([(start, 0)])  # Priority queue with distance and position
    visited = set()
    
    while queue:
        dist, pos = queue.popleft()
        
        if pos == end:
            path = []
            while pos in parent:
                path.append(pos)
                pos = parent[pos]
            return path[::-1], dist
        if pos in visited:
            continue
        
        visited.add(pos)
        
        for dx, dy in directions:
            new_x, new_y = pos[0] + dx, pos[1] + dy
            
            if 0 <= new_x < rows and 0 <= new_y < cols and grid[new_x][new_y] == 0:
                queue.append((dist + 1, (new_x, new_y)))
                parent[(new_x, new_y)] = pos
    return None, float('inf')
