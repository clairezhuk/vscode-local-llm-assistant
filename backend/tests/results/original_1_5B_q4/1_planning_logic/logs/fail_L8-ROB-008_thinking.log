def gcd(a, b):
    # Base case: if one number is 0, the GCD is the other number
    if a == 0:
        return b
    elif b == 0:
        return a
    
    # Recursive case: apply Euclidean algorithm
    while b != 0:
        temp = b
        b = a % b
        a = temp
    
    return a
```


