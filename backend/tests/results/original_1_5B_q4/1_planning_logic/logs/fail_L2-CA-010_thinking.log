import numpy as np

def assign_clusters(points, centroids):
    clusters = []
    for point in points:
        distances = [((point[0] - centroid[0])**2 + (point[1] - centroid[1])**2)**0.5 for centroid in centroids]
        min_distance = min(distances)
        closest_centroid_index = distances.index(min_distance)
        clusters.append(closest_centroid_index)
    return clusters
