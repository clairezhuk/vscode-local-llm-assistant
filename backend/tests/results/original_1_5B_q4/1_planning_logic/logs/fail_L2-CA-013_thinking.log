def parse_nested_logs(lines):
    log_dict = {}
    for line in lines:
        if 'Module[' in line and 'Status[' in line:
            name, value = line.split('Module[')[1].split(': ')[0], line.split('Status[')[1].strip()
            log_dict[name] = value
    return log_dict
