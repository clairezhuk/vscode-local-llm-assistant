```python
def merge_txt_files():
    import os

    # List all .txt files in the current workspace
    txt_files = [f for f in os.listdir('.') if f.endswith('.txt')]

    # Open 'combined.log' in write mode to append content of each .txt file
    with open('combined.log', 'w') as combined_file:
        for file_name in txt_files:
            # Open each .txt file and read its content
            with open(file_name, 'r') as file:
                content = file.read()
                # Write the content to 'combined.log' starting on a new line
                combined_file.write(content + '\n')

    print("Files merged successfully into 'combined.log'")
```


