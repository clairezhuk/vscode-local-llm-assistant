def merge_txt_files():
    import os

    # Get the current directory
    current_dir = os.getcwd()

    # List all .txt files in the current directory
    txt_files = [f for f in os.listdir(current_dir) if f.endswith('.txt')]

    # Open a file to write the merged content
    with open('combined.log', 'w') as combined_file:
        # Iterate over each .txt file and write its content to the combined file
        for file_name in txt_files:
            with open(file_name, 'r') as file:
                combined_file.write(file.read() + '\n')

# Call the function to merge the text files
merge_txt_files()
