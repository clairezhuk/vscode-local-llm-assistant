import os

def get_safe_path(base_dir, user_file):
    # Ensure the base directory is absolute
    if not os.path.isabs(base_dir):
        raise ValueError("Base directory must be absolute")
    
    # Join the base directory and user file to form a full path
    full_path = os.path.join(base_dir, user_file)
    
    # Resolve the absolute path
    resolved_path = os.path.abspath(full_path)
    
    # Verify if the resolved path is within the base directory
    if not resolved_path.startswith(os.path.abspath(base_dir)):
        raise ValueError("The file is outside the base directory")
    
    return resolved_path
```


