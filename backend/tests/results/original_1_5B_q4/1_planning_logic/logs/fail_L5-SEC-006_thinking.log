import os

def get_safe_path(base_dir, user_file):
    # Check if the base directory is a valid path
    if not os.path.isdir(base_dir):
        raise ValueError("Base directory does not exist")
    
    # Join the base directory and user file to form the full path
    full_path = os.path.join(base_dir, user_file)
    
    # Resolve the absolute path of the full path
    abs_path = os.path.abspath(full_path)
    
    # Verify if the absolute path is within the base directory
    if not abs_path.startswith(os.path.abspath(base_dir)):
        raise ValueError("Path outside base directory")
    
    return abs_path
```


