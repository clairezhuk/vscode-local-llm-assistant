def knapsack(capacity, items):
    # Initialize DP table with dimensions (capacity + 1) x (number of items + 1)
    dp = [[0 for _ in range(capacity + 1)] for _ in range(len(items) + 1)]
    
    # Fill the DP table
    for i in range(1, len(items) + 1):
        weight = items[i - 1][0]
        value = items[i - 1][1]
        for j in range(1, capacity + 1):
            if weight <= j:
                dp[j][i] = max(value + dp[j - weight][i - 1], dp[j - 1][i])
            else:
                dp[j][i] = dp[j - 1][i]
    
    # The maximum value that can fit in the capacity
    return dp[capacity][len(items)]
