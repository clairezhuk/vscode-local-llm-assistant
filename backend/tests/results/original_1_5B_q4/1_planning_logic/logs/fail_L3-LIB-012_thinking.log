```python
import torch

def train_step(model, optimizer, criterion, x, y):
    """
    Performs one optimization step: zero gradients, forward pass, calculate loss,
    backward pass, and optimizer step.

    Args:
        model (torch.nn.Module): The neural network model.
        optimizer (torch.optim.Optimizer): The optimizer to use for training.
        criterion (torch.nn.modules.loss._Loss): The loss function.
        x (torch.Tensor): Input data.
        y (torch.Tensor): Target labels.
    """
    # Zero the gradients of the parameters
    optimizer.zero_grad()

    # Forward pass
    output = model(x)

    # Calculate the loss
    loss = criterion(output, y)

    # Backward pass
    loss.backward()

    # Perform a step on the optimizer
    optimizer.step()
```


