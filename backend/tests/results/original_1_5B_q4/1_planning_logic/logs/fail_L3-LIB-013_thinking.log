```python
import numpy as np

def normalize_columns(matrix):
    """Normalizes each column of a 2D NumPy array by subtracting the mean and dividing by the standard deviation."""
    # Calculate the mean of each column
    means = matrix.mean(axis=0)
    
    # Subtract the mean from each element in the corresponding column
    normalized_matrix = np.subtract(matrix, means)
    
    # Divide by the standard deviation to normalize
    std_dev = np.std(normalized_matrix, axis=0)
    normalized_matrix /= std_dev
    
    return normalized_matrix
```

