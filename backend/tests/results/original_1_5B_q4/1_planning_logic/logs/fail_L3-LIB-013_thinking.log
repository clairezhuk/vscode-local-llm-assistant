```python
import numpy as np

def normalize_columns(matrix):
    """Normalizes each column of a 2D NumPy array by subtracting the mean and dividing by the standard deviation."""
    
    # Step: Calculate the mean of each column
    means = np.mean(matrix, axis=0)
    
    # Step: Subtract the mean from each element in the column
    normalized_matrix = matrix - means
    
    # Step: Check if any column has zero standard deviation to avoid division by zero errors
    stds = np.std(normalized_matrix, axis=0)
    normalized_matrix[stds == 0] = 0
    
    return normalized_matrix
```

