import pandas as pd

def merge_dataframes(df1, df2):
    # Merge the DataFrames on 'id' and 'year'
    merged_df = pd.merge(df1, df2, on=['id', 'year'], how='outer')
    
    # Handle conflicts by taking the maximum value for each column
    merged_df = merged_df.groupby(['id', 'year']).max().reset_index()
    
    return merged_df

# Example usage:
df1 = pd.DataFrame({'id': [1, 2, 3], 'year': [2015, 2016, 2017], 'value1': [10, 20, 30]})
df2 = pd.DataFrame({'id': [2, 3, 4], 'year': [2016, 2017, 2018], 'value2': [40, 50, 60]})

result = merge_dataframes(df1, df2)
print(result)
