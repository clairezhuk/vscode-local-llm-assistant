import pandas as pd

def merge_data(df1, df2):
    merged_df = pd.merge(df1, df2, on=['id', 'year'], how='outer')
    
    # Handle conflicts or missing values
    merged_df['value'] = merged_df.apply(lambda row: row['value_x'] if pd.notnull(row['value_x']) else row['value_y'], axis=1)
    merged_df.drop(['value_x', 'value_y'], axis=1, inplace=True)

    return merged_df
