import csv

def calculate_avg(file_path):
    total_amount = 0
    count = 0
    with open(file_path, mode='r', newline='') as file:
        reader = csv.reader(file)
        for row in reader:
            if len(row) > 1:  # Assuming the first column is the transaction amount
                try:
                    amount = float(row[0])
                    total_amount += amount
                    count += 1
                except ValueError:
                    print(f"Invalid amount format in row {row}")
    if count > 0:
        average = total_amount / count
        return average
    else:
        return None
