import math

def rotate_z(point, angle_rad):
    # Macierz rotacji wokół osi Z
    rotation_matrix = [
        [math.cos(angle_rad), -math.sin(angle_rad), 0],
        [math.sin(angle_rad), math.cos(angle_rad), 0]
    ]
    
    # Transponowanie macierzy rotacji
    transposed_rotation_matrix = [[rotation_matrix[j][i] for j in range(3)] for i in range(3)]
    
    # Mnożenie wektora przez macierz rotacji
    rotated_point_vector = [
        transposed_rotation_matrix[0][0] * point[0] + transposed_rotation_matrix[0][1] * point[1] + transposed_rotation_matrix[0][2] * point[2],
        transposed_rotation_matrix[1][0] * point[0] + transposed_rotation_matrix[1][1] * point[1] + transposed_rotation_matrix[1][2] * point[2],
        transposed_rotation_matrix[2][0] * point[0] + transposed_rotation_matrix[2][1] * point[1] + transposed_rotation_matrix[2][2] * point[2]
    ]
    
    # Otrzymanie wektora przesuniętego
    rotated_point = [rotated_point_vector[0], rotated_point_vector[1]]
    
    return rotated_point
