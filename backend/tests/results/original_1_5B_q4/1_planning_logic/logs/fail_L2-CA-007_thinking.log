```python
import re

def parse_log_errors(logs):
    entries = []
    for line in logs.split('\n'):
        match = re.match(r'\\[(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})\\] (ERROR|INFO): (.*)', line)
        if match:
            timestamp, severity, message = match.groups()
            entries.append({'timestamp': timestamp, 'severity': severity, 'message': message})
    return entries
```

